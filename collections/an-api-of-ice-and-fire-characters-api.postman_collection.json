        {
          "id": "c4b93e24-c6ea-46a1-bbf0-905293ea9fc9",
          "name": "An API of Ice And Fire List Characters",
          "request": {
            "name": "An API of Ice And Fire List Characters",
            "description": {
              "content": "List characters from the A Song of Ice and Fire universe. Supports filtering by name, gender, culture, birth year, death year, and living status, plus RFC 5988 Link-header pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "characters"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed). Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "10",
                  "description": "Items per page (default 10, max 50)."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filter characters by name."
                },
                {
                  "disabled": false,
                  "key": "gender",
                  "value": "<string>",
                  "description": "Filter characters by gender (e.g. Male, Female)."
                },
                {
                  "disabled": false,
                  "key": "culture",
                  "value": "<string>",
                  "description": "Filter characters by culture (e.g. Northmen, Dornish, Ironborn)."
                },
                {
                  "disabled": false,
                  "key": "born",
                  "value": "<string>",
                  "description": "Filter characters by birth year (free-text, e.g. \"In 283 AC\")."
                },
                {
                  "disabled": false,
                  "key": "died",
                  "value": "<string>",
                  "description": "Filter characters by death year (free-text)."
                },
                {
                  "disabled": false,
                  "key": "isAlive",
                  "value": "<boolean>",
                  "description": "Filter to only living (true) or only dead (false) characters."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

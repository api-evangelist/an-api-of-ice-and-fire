      "name": "Houses",
      "description": {
        "content": "Noble houses of Westeros and Essos.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b24eae9d-1fce-4417-ab18-49257ad47a9f",
          "name": "An API of Ice And Fire List Houses",
          "request": {
            "name": "An API of Ice And Fire List Houses",
            "description": {
              "content": "List noble houses of Westeros and Essos. Supports filtering by name, region, words/motto, and various boolean has-* filters, plus RFC 5988 Link-header pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "houses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed). Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "10",
                  "description": "Items per page (default 10, max 50)."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filter houses by exact house name."
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Filter houses by region (e.g. \"The North\", \"The Reach\")."
                },
                {
                  "disabled": false,
                  "key": "words",
                  "value": "<string>",
                  "description": "Filter houses by house words (motto)."
                },
                {
                  "disabled": false,
                  "key": "hasWords",
                  "value": "<boolean>",
                  "description": "Restrict to houses that have (true) or do not have (false) words."
                },
                {
                  "disabled": false,
                  "key": "hasTitles",
                  "value": "<boolean>",
                  "description": "Restrict to houses that have (true) or do not have (false) titles."
                },
                {
                  "disabled": false,
                  "key": "hasSeats",
                  "value": "<boolean>",
                  "description": "Restrict to houses that have (true) or do not have (false) seats."
                },
                {
                  "disabled": false,
                  "key": "hasDiedOut",
                  "value": "<boolean>",
                  "description": "Restrict to extinct (true) or surviving (false) houses."
                },
                {
                  "disabled": false,
                  "key": "hasAncestralWeapons",
                  "value": "<boolean>",
                  "description": "Restrict to houses that have (true) or do not have (false) ancestral weapons."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
